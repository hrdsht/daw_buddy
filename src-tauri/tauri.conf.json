{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DAW Buddy",
  "version": "../package.json",
  "identifier": "com.ba55ick.daw-buddy",
  "build": {
    "frontendDist": "../dist/renderer",
    "beforeBuildCommand": "npm run build:renderer && node scripts/copy-assets.js",
    "beforeDevCommand": "npm run build:renderer && node scripts/copy-assets.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DAW Buddy",
        "width": 1320,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Music",
    "shortDescription": "Browse, analyse and tidy your music production sessions"
  }
}
